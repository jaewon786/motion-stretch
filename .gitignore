# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 비밀 값 파일은 절대 커밋하지 않는다 (교재 Part 2 STEP 2)
.env

# 지울 파일을 잠시 옮겨 두는 폴더 (사용자 확인 후 삭제, 커밋하지 않음)
trash-can/

# bkit 플러그인 실행 기록 (도구가 자동으로 계속 바꾸는 파일)
.bkit/
